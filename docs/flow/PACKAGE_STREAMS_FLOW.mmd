    START["packages.lua<br/>aggregate_all_packages"]
    
    START --> COLLECT["Collect from all sources:<br/>• desktop.environments[*]<br/>• hardware[*]<br/>• programs[*]<br/>• users[user].programs[*]<br/>• fonts<br/>• system packages"]
    
