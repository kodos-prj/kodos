    A --> AE["emit_steps<br/>order: 490-501+"]
    AE --> AE0["Prerequisite: #aur_pkgs > 0"]
    AE0 --> AE1["490: install base-devel + git"]
    AE1 --> AE2["492: create kod user"]
    AE2 --> AE3["493: kod sudoers"]
    AE3 --> AE4["494: build yay-bin"]
    AE4 --> AE5["500+: build each AUR package"]
    
    AE5 --> AE5A["brother-dcp-l2550dw: yay -S"]
    AE5 --> AE5B["mission-center: yay -S"]
    
    AE2 --> AE_DETAIL["useradd -r -m -s /bin/bash kod<br/>Execution (chroot):<br/>• Creates user with bash shell<br/>• Home: /home/kod<br/>• Allows command execution"]
    
    AE3 --> AE_SUDO["echo 'kod ALL=(ALL) NOPASSWD: ALL'<br/>Execution (chroot):<br/>• kod can run any sudo command<br/>• No password needed<br/>• Safe in temporary chroot"]
    
    AE4 --> AE_YAY["git clone yay-bin && chown && makepkg<br/>Execution (chroot):<br/>1. git clone from AUR<br/>2. chown -R kod:kod (fix permissions)<br/>3. sudo -u kod makepkg -si<br/>   • Runs as non-root (required by makepkg)<br/>   • Installs via pacman -U<br/>⏱️ Timeout: 900s"]
    
    AE5A --> AE_BUILD["sudo -u kod yay -S --needed<br/>Execution (chroot):<br/>• yay available system-wide<br/>• Runs as kod user (non-root)<br/>• makepkg can execute safely<br/>• yay uses sudo for pacman -U<br/>• Downloads & builds AUR package<br/>⏱️ Timeout: 900s"]
    
